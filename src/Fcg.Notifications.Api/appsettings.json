{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true,
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Messaging": {
    "Queues": {
      "UserCreated": "notifications.user-created",
      "PaymentProcessed": "notifications.payment-processed"
    },
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8
  },
  "Email": {
    "From": "no-reply@fiapcloudgames.com"
  }
}
